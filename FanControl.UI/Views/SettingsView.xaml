<UserControl
    x:Class="FanControl.UI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FanControl.UI.Localization">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="260" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="Toggle"
                                Focusable="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border
                                    Background="White"
                                    BorderBrush="#C8C8C8"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid>
                                        <ContentPresenter
                                            Margin="10,0,28,0"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            IsHitTestVisible="False" />
                                        <Path
                                            Data="M 0 0 L 4 4 L 8 0"
                                            Stroke="#666666"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup
                                x:Name="Popup"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                AllowsTransparency="True">
                                <Border
                                    Background="White"
                                    BorderBrush="#C8C8C8"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="300"
                                    Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="3,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#E5F1FB" />
                                            <Setter Property="Foreground" Value="Black" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#F0F0F0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="260" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="2,0,2,4">
            <TextBlock
                x:Name="StatusText"
                Text="{loc:Translate Settings.Loading}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Margin="0,4,0,12" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Card.TempFan}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.Source}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="SourceCombo" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.GpuSource}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="GpuSourceCombo" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.Gpu}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="GpuCombo" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.RpmSource}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="RpmSourceCombo" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.Mode}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="ModeCombo" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.ManualPwm}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="ManualSlider" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" ValueChanged="ManualSlider_ValueChanged" />
                        <TextBlock x:Name="ManualValue" Grid.Column="2" Text="50 %" Width="52" TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.SmoothEnable}" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="SmoothToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                      Checked="SmoothToggle_Checked" Unchecked="SmoothToggle_Checked" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.Smooth}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="SmoothSlider" Grid.Column="1" Margin="12,0" Minimum="0.1" Maximum="1"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="SmoothSlider_ValueChanged" />
                        <TextBlock x:Name="SmoothValue" Grid.Column="2" Text="0.5" Width="52" TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Card.Comm}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.ConnState}" Style="{StaticResource RowLabel}" />
                        <TextBlock x:Name="ConnStateText" Grid.Column="1" Text="--"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                    <Button Content="{loc:Translate Settings.ManualReconnect}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Reconnect_Click"
                            HorizontalAlignment="Right"
                            Padding="14,6"
                            Margin="0,6,0,0" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.CommType}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="CommCombo" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.BleName}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="BleBox" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.ComPort}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="ComPortBox" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.Baud}" Style="{StaticResource RowLabel}" />
                        <TextBox x:Name="BaudBox" Grid.Column="1" Style="{StaticResource TextBoxStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.BlePoll}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="BlePollSlider" Grid.Column="1" Margin="12,0" Minimum="1" Maximum="30"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="BlePollSlider_ValueChanged" />
                        <TextBlock x:Name="BlePollValue" Grid.Column="2" Text="5" Width="52" TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.BleReconnect}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="BleReconnectSlider" Grid.Column="1" Margin="12,0" Minimum="1" Maximum="60"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="BleReconnectSlider_ValueChanged" />
                        <TextBlock x:Name="BleReconnectValue" Grid.Column="2" Text="10" Width="52" TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.BleAuto}" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="BleAutoToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Card.System}" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.Poll}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="PollSlider" Grid.Column="1" Margin="12,0" Minimum="0.1" Maximum="5"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="PollSlider_ValueChanged" />
                        <TextBlock x:Name="PollValue" Grid.Column="2" Text="1.0" Width="52" TextAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.Autostart}" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="AutostartToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                      Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.LogLocation}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="LogLocationCombo" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.LogEnabled}" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="LogToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.Theme}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                  SelectionChanged="ThemeCombo_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Settings.Language}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="LangCombo" Grid.Column="1" Style="{StaticResource ComboStyle}"
                                  SelectionChanged="LangCombo_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.TempUnit}" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="UnitCombo" Grid.Column="1" Style="{StaticResource ComboStyle}" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.NotifyBle}" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="NotifyBleToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate Row.NotifyError}" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="NotifyErrorToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <Button Content="{loc:Translate Settings.Reload}" Style="{StaticResource SecondaryButtonStyle}" Click="Reload_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
