<Window
    x:Class="FanControl.UI.Views.LogLocationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FanControl - 首次启动 / First Launch"
    Width="600"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Background="White"
    Foreground="#222222"
    FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="PathButton" TargetType="Button">
            <Setter Property="Width" Value="252" />
            <Setter Property="Height" Value="72" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#F4F6F8" />
            <Setter Property="BorderBrush" Value="#D5DBE0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E8F1F3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D7E7EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="30,24,30,26">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Text="FanControl"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#0E7C86"
                VerticalAlignment="Center" />
            <TextBlock
                Text="日志文件存放位置 / Log file location"
                FontSize="13"
                Foreground="#666666"
                Margin="12,0,0,0"
                VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Margin="0,16,0,0" FontSize="13" TextWrapping="Wrap">
            请选择日志文件存放位置（之后可在设置中修改）：/ Choose where to store log files (can be changed later in Settings):
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="DataButton" Style="{StaticResource PathButton}" Click="Data_Click">
                <StackPanel>
                    <TextBlock Text="用户数据目录 (data) / User data (data)" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="DataPathText" FontSize="11" Foreground="#777777" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
            <Button x:Name="InstallButton" Style="{StaticResource PathButton}" Margin="0" Click="Install_Click">
                <StackPanel>
                    <TextBlock Text="安装目录 / Install directory" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="InstallPathText" FontSize="11" Foreground="#777777" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock
            Text="提示：安装目录需要管理员权限（本程序以管理员运行）；用户数据目录位于 %AppData%\FanControl\data。"
            FontSize="11"
            Foreground="#999999"
            TextWrapping="Wrap"
            Margin="0,16,0,0" />
    </StackPanel>
</Window>
