<Window
    x:Class="FanControl.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FanControl.UI.Localization"
    Title="FanControl"
    Icon="/app.ico"
    Width="1120"
    Height="720"
    MinWidth="960"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WindowBgBrush}"
    FontFamily="Microsoft YaHei UI"
    FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource BorderSecondBrush}"
            BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,36,12,16">
                    <TextBlock
                        Text="FanControl"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock
                        Text="{loc:Translate Subtitle}"
                        FontSize="10"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Margin="2,6,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="16,8,16,14">
                    <Button
                        Content="{loc:Translate Quit}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="0,8"
                        Click="Quit_Click" />
                </Border>

                <ListBox
                    x:Name="NavList"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,8,0,0"
                    SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="dashboard" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{loc:Translate Nav.Dashboard}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="curve" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{loc:Translate Nav.Curve}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{loc:Translate Nav.Settings}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="about" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{loc:Translate Nav.About}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1" Margin="20,12,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PageTitle"
                    Text="{loc:Translate Page.Dashboard}"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="1"
                    Text="{loc:Translate Status.Waiting}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    VerticalAlignment="Center" />
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</Window>
